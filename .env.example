# Copy to .env and fill in. Never commit .env. Every value below is read by a tool, script or README step.
# Run tools with: node --env-file=../../.env tools/<name>.ts   (from apps/web)

# Robinhood Chain Testnet
ROBINHOOD_RPC=https://rpc.testnet.chain.robinhood.com
CHAIN_ID=46630

# Owner/deployer wallet: used by forge deploy scripts (packages/contracts/script) and apps/web/tools (market, agent-4337)
DEPLOYER_PRIVATE_KEY=
# The AI agent's wallet: address for the Deploy script, key for tools/run-agent.ts
AGENT_ADDRESS=
AGENT_PRIVATE_KEY=
# Six bot wallets, comma separated, for the market keeper. `tools/market-setup.ts --generate` fills this in.
BOT_PRIVATE_KEYS=

# Gemini, used by tools/run-agent.ts to let the agent decide
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite   (optional; leave commented to use this default, an empty value would be used as-is)

# SerpApi, used only by apps/web/worker/scripts/seed-prices.ts (the Worker itself uses wrangler secrets, see apps/web/.dev.vars.example)
SERPAPI_KEY=

# Optional overrides for the market deploy script (DeployBook.s.sol) and the agent deploy script (DeployAgents.s.sol).
# Leave them commented out: an empty value is not a number or an address and makes forge fail.
# EPOCH_LEN=45
# COMMIT_END=20
# REVEAL_END=35
# BOND=2000000
# FAUCET=<address of an existing TokenFaucet to reuse>
